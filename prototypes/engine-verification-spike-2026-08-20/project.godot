; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

; 2026-08-20:headless 跑法必須開這個,否則 print() 全被緩衝,
; 程式不退出就一個字都看不到(這個設定本身是 C3 那一節掃出來的)。
run/flush_stdout_on_print=true

config/name="Engine Verification Spike (2026-08-20)"
config/description="Throwaway spike answering ADR-0002 Verification Required 1/2/3 and ADR-0005 VR #1/#3/#15. Run the main scene and copy the whole report back. See README.md."
run/main_scene="res://scenes/VerificationScene.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=900
window/size/viewport_height=600
